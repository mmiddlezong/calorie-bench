# Copy to .env and fill in the keys you have. Models without a key are skipped.
# .env is gitignored.

# Anthropic (Claude). If unset, the SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=

# OpenAI (GPT-6 family)
OPENAI_API_KEY=

# Google Gemini API / AI Studio (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# OpenRouter (open-weight models: Kimi K3, Qwen3.8 Flash, Ling 3.0 Flash VL, MiniMax-M3)
OPENROUTER_API_KEY=
